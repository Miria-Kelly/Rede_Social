Create table if not exists Perfil(usuario varchar(15) not null,
								  email varchar(254) not null unique,
                                  nome varchar(20) not null,
                                  senha varchar(20) not null,
                                  perfil_aberto boolean not null,
                                  primary key(usuario)
                                  );
                                  
create table if not exists Segue (user_seguidor varchar(15) not null,
								  user_seguido varchar(15) not null,
                                  data_hora timestamp,
                                  primary key(user_seguidor, user_seguido),
                                  foreign key(user_seguidor) references Perfil(usuario),
                                  foreign key(user_seguido) references Perfil(usuario)
                                  );

create table if not exists Conversa(id_conversa int,
									tipo_conversa varchar(10),
									primary key(id_conversa)
                                    );
                                    
                                    
create table if not exists Participa(usuario varchar(15),
									 id_conversa int,
                                     primary key(usuario, id_conversa),
                                     foreign key (usuario) references perfil(usuario),
                                     foreign key (id_conversa) references Conversa(id_conversa)
                                     );

                                    
create table if not exists Mensagem(id_mensagem INT AUTO_INCREMENT,
									id_Conversa int not null,
                                    usuario varchar(15) not null,
                                    data_hora timestamp not null,
                                    conteudo text,
                                    
                                    primary key(id_mensagem),
									foreign key (id_conversa) references Conversa(id_conversa),
                                    foreign key (usuario) references Perfil(usuario)
                                    );
      
create table if not exists Publicacao(id_publicacao INT AUTO_INCREMENT, 
									  user_publi varchar(15) not null,
                                      data_hora timestamp,
                                      
                                      primary key (id_publicacao),
                                      foreign key(user_publi) references Perfil(usuario)
                                      );




create table if not exists Interacao(id_interacao INT AUTO_INCREMENT,
									 usuario varchar(15) not null,
                                     id_publicacao int NOT NULL,
                                     data_hora timestamp,
                                     
                                     primary key(id_interacao),
                                     foreign key(usuario) references Perfil(usuario),
                                     foreign key(id_publicacao) references Publicacao(id_publicacao)
                                     );
       
create table if not exists interacao_comentario(id_interacao int not null,
											 texto text,
											 primary key(id_interacao),
                                             foreign key(id_interacao) references Interacao(id_interacao)
                                             );
                                             

create table if not exists interacao_curtida(id_interacao INT NOT NULL,
											 primary key(id_interacao),
                                             foreign key(id_interacao) references Interacao(id_interacao)
                                             );
            
		
create table if not exists Arquivo_midia(id_arquivo INT AUTO_INCREMENT,
										 id_publicacao INT NOT NULL,
                                         tipo_midia varchar(15),
                                         
                                         primary key (id_arquivo),
                                         foreign key (id_publicacao) references publicacao(id_publicacao)
                                         );

create table if not exists Publicacao_permanente(id_publicacao INT NOT NULL,
												legenda varchar(254),
                                                
                                                primary key(id_publicacao),
												foreign key (id_publicacao) references publicacao(id_publicacao)
                                                );

 create table if not exists Publicacao_Temporaria (id_publicacao INT NOT NULL,
												  data_expiracao TIMESTAMP NOT NULL,

												  PRIMARY KEY (id_publicacao),
												  FOREIGN KEY (id_publicacao) REFERENCES Publicacao(id_publicacao)
	);